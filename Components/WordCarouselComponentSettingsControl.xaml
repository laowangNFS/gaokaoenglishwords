<ci:ComponentBase
    x:TypeArguments="local:WordCarouselComponentSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:local="clr-namespace:Englishwordsshow.Components"
    x:Class="Englishwordsshow.Components.WordCarouselComponentSettingsControl" FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="轮播设置" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
            <TextBlock Text="每次固定显示 2 个单词（英文 + 词性/中文释义），按设定间隔自动切换。"
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,10" />

            <TextBlock Text="轮播间隔" Margin="0,0,0,5" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <NumericUpDown Minimum="3" Maximum="600"
                               Increment="1" FormatString="0"
                               Value="{Binding Settings.IntervalSeconds}"
                               Width="130" />
                <TextBlock Text="秒" VerticalAlignment="Center" />
            </StackPanel>

            <CheckBox Content="随机顺序（关闭后按字母顺序）"
                      IsChecked="{Binding Settings.RandomOrder}" Margin="0,3" />

            <Separator Margin="0,12" />

            <TextBlock Text="字体大小" Margin="0,0,0,5" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Slider Minimum="12" Maximum="20"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.FontSize}"
                        Width="210" />
                <TextBlock Text="{Binding Settings.FontSize, StringFormat='{}{0:0} pt'}"
                           VerticalAlignment="Center" Width="50" />
            </StackPanel>
            <TextBlock Text="组件高度约 55px，字号过大会把中文释义挤出可视区域；建议 16–20 pt。"
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,6,0,0" />

            <Separator Margin="0,12" />

            <TextBlock Text="词库" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12">
                词库从插件目录下的 Assets/gaokao3600.xml 本地加载，不会联网下载。
                也可以用环境变量 ENGLISHWORDSSHOW_XML 指定其他 XML 文件。
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
